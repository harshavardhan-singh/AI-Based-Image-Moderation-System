{
“Version”: “2012–10–17”,
“Statement”: [
{
“Sid”: “S3ReadAccess”,
“Effect”: “Allow”,
“Action”: [
“s3:GetObject”
],
“Resource”: “arn:aws:s3:::image-moderation-input-*/*”
},
{
“Sid”: “RekognitionAccess”,
“Effect”: “Allow”,
“Action”: [
“rekognition:DetectModerationLabels”
],
“Resource”: “*”
},
{
“Sid”: “DynamoDBAccess”,
“Effect”: “Allow”,
“Action”: [
“dynamodb:PutItem”
],
“Resource”: “arn:aws:dynamodb:*:*:table/ImageModerationResults”
},
{
“Sid”: “SNSPublishAccess”,
“Effect”: “Allow”,
“Action”: [
“sns:Publish”
],
“Resource”: “*”
},
{
“Sid”: “CloudWatchLogs”,
“Effect”: “Allow”,
“Action”: [
“logs:CreateLogGroup”,
“logs:CreateLogStream”,
“logs:PutLogEvents”
],
“Resource”: “*”
}
]
}
